# Auth901 systemd unit
#
# Expected layout on the host:
#   /home/auth901/auth901_cd/
#     server
#     .env
#     conf/app.conf
#     web/build/...
#     swagger/          (optional)
#     logs/
#     tmp/
#
# Install:
#   sudo useradd --system --home /home/auth901 --shell /usr/sbin/nologin auth901
#   sudo chown -R auth901:auth901 /home/auth901/auth901_cd
#   sudo mkdir -p /home/auth901/auth901_cd/logs /home/auth901/auth901_cd/tmp
#   sudo cp /home/auth901/auth901_cd/auth901_daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now auth901_daemon

[Unit]
Description=Auth901 (Casdoor) identity and access management
Documentation=https://casdoor.ai/docs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=auth901
Group=auth901
WorkingDirectory=/home/auth901/auth901_cd
ExecStart=/home/auth901/auth901_cd/server
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=false
PrivateTmp=true
ReadWritePaths=/home/auth901/auth901_cd/logs /home/auth901/auth901_cd/tmp

[Install]
WantedBy=multi-user.target
