# Auth901 systemd unit
#
# Expected layout on the host:
#   /home/ubuntu/auth901_cd/
#     server
#     .env
#     conf/app.conf
#     web/build/...
#     swagger/          (optional)
#     logs/
#     tmp/
#
# Install:
#   sudo mkdir -p /home/ubuntu/auth901_cd/logs /home/ubuntu/auth901_cd/tmp
#   sudo chown -R ubuntu:ubuntu /home/ubuntu/auth901_cd
#   chmod +x /home/ubuntu/auth901_cd/server
#   sudo cp /home/ubuntu/auth901_cd/auth901_daemon.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now auth901_daemon

[Unit]
Description=Auth901 (Casdoor) identity and access management
Documentation=https://casdoor.ai/docs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/auth901_cd
ExecStart=/home/ubuntu/auth901_cd/server
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
