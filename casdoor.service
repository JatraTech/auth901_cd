# Casdoor systemd unit
#
# Expected layout on the host:
#   /opt/casdoor/
#     server
#     .env
#     conf/app.conf
#     web/build/...
#     swagger/          (optional)
#     logs/
#     tmp/
#
# Install:
#   sudo useradd --system --home /opt/casdoor --shell /usr/sbin/nologin casdoor
#   sudo chown -R casdoor:casdoor /opt/casdoor
#   sudo mkdir -p /opt/casdoor/logs /opt/casdoor/tmp
#   sudo cp deploy/casdoor.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now casdoor

[Unit]
Description=Casdoor identity and access management
Documentation=https://casdoor.ai/docs
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=casdoor
Group=casdoor
WorkingDirectory=/opt/casdoor
ExecStart=/opt/casdoor/server
Restart=on-failure
RestartSec=5
LimitNOFILE=65536

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/casdoor/logs /opt/casdoor/tmp

[Install]
WantedBy=multi-user.target
